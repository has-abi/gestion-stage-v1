				<reportElement x="380" y="381" width="90" height="22" uuid="365c82ed-969e-42c9-ac8f-eef3889b0082"/>
				<textElement>
					<font fontName="Times New Roman" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[- Etudiant –]]></text>
			</staticText>
		</band>
	</summary>
