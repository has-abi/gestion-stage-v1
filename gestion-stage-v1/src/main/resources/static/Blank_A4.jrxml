	<queryString>
		<![CDATA[select u.nom,u.prenom,o.raison_sociale,o.adress,o.tele,e.cin from etudiant e,organisme_accueil o,utilisateur u,stage_etudiant se,stage s where s.id=1 and se.stage = s.id and e.id=se.etudiant and e.utilisateur = u.id and o.id = s.organisme_accueil]]>
